{
  "name": "hundun-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "hundun-dsh：聚合的 DeepSeek Harness (DSH) 插件全家桶 monorepo。每个插件是一个符合官方标准（turtle-ui 式 setup / dsh bundle patch）的独立可安装包，聚合包 dsh-all 一键装配全部插件。",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "aggregate": "node scripts/aggregate.mjs",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "plugin:new": "node scripts/plugin-new.mjs"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2"
  },
  "license": "Apache-2.0"
}
